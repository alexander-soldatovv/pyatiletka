# Обязательные секреты. Не коммитьте заполненный .env.
BOT_TOKEN=
BOT_USERNAME=
EVENT_SALT=replace-with-a-random-value-at-least-16-characters

# Только для явного `npm run smoke:real -- --send`; приложение эту переменную не читает.
SMOKE_USER_ID=

# Режим MAX: polling работает без публичного URL, webhook нужен для production.
BOT_MODE=polling
MAX_API_BASE=https://platform-api2.max.ru
MAX_REQUEST_TIMEOUT_MS=35000
QUEUE_MIN_INTERVAL_MS=500

# HTTP и SQLite. В compose PORT публикуется на хосте, а DB_PATH переопределён на /data.
PORT=3000
DB_PATH=./data/pyatiletka.sqlite
NODE_EXTRA_CA_CERTS=./certs/russian_trusted_ca.pem

# Напоминания.
REMINDER_TZ=Europe/Moscow
REMINDER_INTERVAL_SEC=900
REMINDER_FROM_HOUR=9
REMINDER_TO_HOUR=20
ANNUAL_REMINDER_DATES=04-01,09-01,11-01

# Mini App и защита внутреннего API.
MINIAPP_ENABLED=true
ALLOW_DEMO_AUTH=false
DEMO_USER_ID=900000001
INIT_DATA_MAX_AGE_SEC=3600
API_RATE_LIMIT=60
REQUEST_BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=10000
HEADERS_TIMEOUT_MS=5000
ADMIN_TOKEN=replace-with-random-admin-token

# Нужны только для webhook в production. PUBLIC_BASE_URL должен быть HTTPS.
PUBLIC_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
